NODE_ENV=development
LOG_LEVEL=info
PORT=3000
EXPOSE_ROUTES=true
POSTGRES_DB_HOST=db
POSTGRES_DB_PORT=5432
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppassword
DB_HOST=db
DB_PORT=5432
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=apppassword
VAULT_ADDR=http://vault:8200
VAULT_KV_PATH=secret/data/postgres
VAULT_DB_ROLE={{ 'viewer-read' if 'roles' in zt_features else 'app-role' }}
VAULT_DB_ROLE_VIEWER=viewer-read
VAULT_DB_ROLE_SUPPORT=support-read
VAULT_DB_ROLE_ADMIN=admin-read
VAULT_JWT_ROLE=zero-trust-jwt-lab
VAULT_TOKEN={{ zt_runtime_identity.get('token', '') if 'kv' in zt_features and 'approle' not in zt_features else '' }}
VAULT_ROLE_ID={{ zt_runtime_identity.get('role_id', '') }}
VAULT_SECRET_ID={{ zt_runtime_identity.get('secret_id', '') }}
VAULT_AGENT_CREDS_FILE=/vault/secrets/db-creds.json
KEYCLOAK_ADDR=http://keycloak:8080
KEYCLOAK_REALM=zero-trust
KEYCLOAK_CLIENT_ID=backend
KEYCLOAK_CLIENT_SECRET={{ zt_kc_identity.client_secret }}
KEYCLOAK_USERNAME={{ 'repping' if 'jwt' in zt_features else '' }}
KEYCLOAK_PASSWORD={{ 'password' if 'jwt' in zt_features else '' }}
JWKS_URL=http://keycloak:8080/realms/zero-trust/protocol/openid-connect/certs
JWT_ISSUER=http://keycloak:8080/realms/zero-trust
CIBA_POLL_INTERVAL=1000
CIBA_TIMEOUT=120000
